# Local: copy to .env.local. Deployed (Vercel): set the same names under Project → Settings → Environment Variables.

# Leonardo API key. Without one the app runs in MOCK mode (placeholder images, no credits spent).
LEONARDO_API_KEY=
# Force mock mode even with a key present (1 = on)
LEONARDO_MOCK=0
# Max generations in flight at once (the account allows 10)
LEONARDO_MAX_CONCURRENT=6

# Team sign-in: one shared password; each person picks their name. Leave empty locally to skip the password.
TEAM_PASSWORD=
# Long random string used to sign sign-in cookies (changing it signs everyone out)
SESSION_SECRET=
# Cap on distinct names that can sign in
TEAM_MAX_MEMBERS=6

# Deployed only — leave empty locally (local uses data/lab.db and data/media, data/uploads).
# Turso database (libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob store (added automatically when you connect a Blob store to the Vercel project)
BLOB_READ_WRITE_TOKEN=
